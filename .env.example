# ─────────────────────────────────────────────────────────────────────────────
# E-Street Bot configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# 32-byte key (base64) used to encrypt portal passwords + OAuth tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDS_ENCRYPTION_KEY=

# Path to the encrypted accounts store (JSON). One record per connected account.
ACCOUNTS_STORE=./data/accounts.enc.json

# Path to the encrypted central-inbox Gmail connection (ONE for the whole system).
GMAIL_CONNECTION_STORE=./data/gmail.enc.json

# Path to encrypted per-account portal session cookies. Lets a worker resume its
# portal session across restarts instead of logging in (and hitting OTP, if the
# account requires it) fresh every time — same reason a closed-and-reopened
# browser doesn't get asked for credentials again.
SESSION_COOKIE_STORE=./data/sessions.enc.json

# Lock backend: "memory" (single process) or "redis" (multi-process fleet).
LOCK_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379

# Control-plane HTTP server
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_TOKEN=change-me-admin-token

# Detection tuning (milliseconds)
# Portal poll — lower = faster detection, higher ban risk.
# Competitive FCFS: 300. Raise to 2000+ if the portal starts 403/429'ing.
PORTAL_POLL_INTERVAL_MS=300
# Minimum allowed poll interval (clamped with a warning). Set 0 in tests.
PORTAL_POLL_FLOOR_MS=300
# After this many consecutive 403/429/timeouts, pause portal polling (Gmail still runs).
PORTAL_CIRCUIT_THRESHOLD=5
# How long to wait before auto-probing the portal again after a circuit open.
PORTAL_CIRCUIT_COOLDOWN_MS=1800000
ORDER_LOCK_TTL_MS=120000
# Min time before retrying a worker start() that just failed (e.g. an OTP-gated
# login that timed out). Every account add/activate/remove triggers a reconcile
# that retries ALL not-yet-running active accounts — without this cooldown, an
# unrelated account change re-triggers a fresh login (and a fresh OTP dispatch)
# for an account that just failed, every time.
WORKER_START_RETRY_COOLDOWN_MS=300000
# How often to poll the central Gmail for new forwarded orders (the fetch path
# when there's no Pub/Sub push). Lower = faster detection, more API calls.
GMAIL_POLL_INTERVAL_MS=500
GMAIL_POLL_FLOOR_MS=500
# Skip an extra New Orders GET on accept when the poller just fetched the page.
REUSE_CACHED_PAGE=1
# Hot-path accept/decline HTTP timeout (ms). Login/poll keep the HttpClient default (10s).
# A hung request past ~2–3s has already lost the FCFS race.
ACCEPT_HTTP_TIMEOUT_MS=3000
# Soft ceiling for confirm Accept POST before returning submitted (POST stays in flight).
CONFIRM_POST_TIMEOUT_MS=1200
# Early Accept=asis GET probe timeout before falling back to list postback.
EARLY_ASIS_TIMEOUT_MS=1200
# After soft submit, re-check portal status this many times when first verify is unknown.
VERIFY_RETRY_COUNT=3
VERIFY_RETRY_MS=400

# Gmail push (ONE central inbox; every user forwards their order emails into it).
# 1) Create a Google Cloud project + OAuth client (Web) + Pub/Sub topic.
# 2) Add redirect URI: http://localhost:8787/oauth/google/callback
# 3) In the admin dashboard Accounts page, click "Connect central inbox" ONCE.
#    Each user is then matched by their `forwardingEmail` on the account record.

# OPTIONAL — bootstrap the central inbox WITHOUT the browser OAuth flow (handy for
# deploys): paste the central mailbox + its OAuth refresh token here. If set and no
# token is stored on disk, the app connects from these. Keep secret (.env is gitignored).
GMAIL_ADDRESS=
GMAIL_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/google/callback
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/estreet-orders
GMAIL_PUBSUB_VERIFICATION_TOKEN=change-me-pubsub-token
