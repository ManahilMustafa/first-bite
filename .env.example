# ─────────────────────────────────────────────────────────────────────────────
# E-Street Bot configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# 32-byte key (base64) used to encrypt portal passwords + OAuth tokens at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDS_ENCRYPTION_KEY=

# Path to the encrypted accounts store (JSON). One record per connected account.
ACCOUNTS_STORE=./data/accounts.enc.json

# Path to the encrypted central-inbox Gmail connection (ONE for the whole system).
GMAIL_CONNECTION_STORE=./data/gmail.enc.json

# Lock backend: "memory" (single process) or "redis" (multi-process fleet).
LOCK_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379

# Control-plane HTTP server
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_TOKEN=change-me-admin-token

# Detection tuning (milliseconds)
PORTAL_POLL_INTERVAL_MS=2000
ORDER_LOCK_TTL_MS=120000
# How often to poll the central Gmail for new forwarded orders (the fetch path
# when there's no Pub/Sub push). Lower = faster detection, more API calls.
GMAIL_POLL_INTERVAL_MS=15000

# Gmail push (ONE central inbox; every user forwards their order emails into it).
# 1) Create a Google Cloud project + OAuth client (Web) + Pub/Sub topic.
# 2) Add redirect URI: http://localhost:8787/oauth/google/callback
# 3) In the admin dashboard Accounts page, click "Connect central inbox" ONCE.
#    Each user is then matched by their `forwardingEmail` on the account record.

# OPTIONAL — bootstrap the central inbox WITHOUT the browser OAuth flow (handy for
# deploys): paste the central mailbox + its OAuth refresh token here. If set and no
# token is stored on disk, the app connects from these. Keep secret (.env is gitignored).
GMAIL_ADDRESS=
GMAIL_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/google/callback
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/estreet-orders
GMAIL_PUBSUB_VERIFICATION_TOKEN=change-me-pubsub-token
